# ---- dense embeddings (provider:model, resolved by pydantic-ai) ----
EMBEDDING_MODEL=voyageai:voyage-code-4
EMBEDDING_DIMENSIONS=2048
EMBEDDING_QUANTIZATION=float32
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_BATCH_TOKENS=100000

# What a million input tokens costs. Used only when the provider reports no
# price of its own -- genai-prices has no entry for voyage-code-4, so without
# this every run records $0.0000, which reads as free rather than as unknown.
# A number here goes stale silently, so a cost derived from it is displayed as
# an estimate (~$0.1234) rather than as a fact.
EMBEDDING_PRICE_PER_MTOK=0.12

# Size of the provider's free allowance, if it has one. `status` reports how
# much of it this manifest has drawn down. Approximate by construction: the
# allowance belongs to the account and is spent by everything using the key.
EMBEDDING_FREE_TIER_TOKENS=200000000
VOYAGE_API_KEY=

# ---- sparse (local, free) ----
SPARSE_MODEL=Qdrant/bm25

# ---- reranking ----
RERANK_ENABLED=true
RERANK_MODEL=voyageai:rerank-2.5-lite

# ---- vector store ----
VECTOR_STORE=qdrant
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ON_DISK_PAYLOAD=true

# ---- state ----
STATE_DB=./data/manifest.sqlite3

# ---- logging ----
LOG_LEVEL=INFO
LOGFIRE_ENABLED=false
LOGFIRE_SEND_TO_CLOUD=false
LOGFIRE_TOKEN=
